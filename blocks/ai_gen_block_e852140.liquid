{% doc %}
  @prompt
    Separator
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-separator-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-separator-line-{{ ai_gen_id }} {
    border: none;
    height: {{ block.settings.thickness }}px;
    background: {{ block.settings.separator_color }};
    margin: 0;
    {% if block.settings.style == 'dashed' %}
      background: repeating-linear-gradient(
        to right,
        {{ block.settings.separator_color }} 0px,
        {{ block.settings.separator_color }} {{ block.settings.dash_length }}px,
        transparent {{ block.settings.dash_length }}px,
        transparent {{ block.settings.dash_length | plus: block.settings.dash_gap }}px
      );
    {% elsif block.settings.style == 'dotted' %}
      background: repeating-linear-gradient(
        to right,
        {{ block.settings.separator_color }} 0px,
        {{ block.settings.separator_color }} {{ block.settings.dot_size }}px,
        transparent {{ block.settings.dot_size }}px,
        transparent {{ block.settings.dot_size | plus: block.settings.dot_gap }}px
      );
      height: {{ block.settings.dot_size }}px;
    {% elsif block.settings.style == 'gradient' %}
      background: linear-gradient(
        to right,
        transparent,
        {{ block.settings.separator_color }},
        transparent
      );
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-separator-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-separator-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <hr class="ai-separator-line-{{ ai_gen_id }}">
</div>

{% schema %}
{
  "name": "Separator",
  "settings": [
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Color",
      "default": "#44372b"
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Dashed style"
    },
    {
      "type": "range",
      "id": "dash_length",
      "label": "Dash length",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "dash_gap",
      "label": "Dash gap",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Dotted style"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot size",
      "min": 2,
      "max": 10,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "dot_gap",
      "label": "Dot gap",
      "min": 2,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Separator"
    }
  ]
}
{% endschema %}

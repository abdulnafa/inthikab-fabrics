{%- liquid
  assign featured_collection = section.settings.featured_collection
  if featured_collection == blank
    assign featured_collection = collections['winter-collection']
  endif

  assign shop_url = section.settings.shop_link
  if shop_url == blank and featured_collection != blank
    assign shop_url = featured_collection.url
  endif
  if shop_url == blank
    assign shop_url = routes.all_products_collection_url
  endif
-%}

<section class="if-about" aria-labelledby="if-about-title-{{ section.id }}">
  <div class="if-about__hero">
    <div class="if-about__hero-inner page-width">
      <div class="if-about__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="if-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h1 id="if-about-title-{{ section.id }}">{{ section.settings.heading | escape }}</h1>

        {%- if section.settings.intro != blank -%}
          <div class="if-about__lead rte">{{ section.settings.intro }}</div>
        {%- endif -%}

        <div class="if-about__actions">
          <a class="if-button if-button--gold" href="{{ shop_url }}">
            {{ section.settings.shop_label | escape }}
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a class="if-button if-button--ghost" href="{{ routes.root_url }}pages/contact">
            Talk to us
          </a>
        </div>
      </div>

      <div class="if-about__gallery" aria-label="Selected Intikhab Fabrics articles">
        {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
          {%- for product in featured_collection.products limit: 3 -%}
            <a class="if-about__image if-about__image--{{ forloop.index }}" href="{{ product.url }}">
              {%- assign image_alt = product.featured_image.alt | default: product.title -%}
              {%- assign image_loading = 'lazy' -%}
              {%- assign image_priority = 'auto' -%}
              {%- if forloop.first -%}
                {%- assign image_loading = 'eager' -%}
                {%- assign image_priority = 'high' -%}
              {%- endif -%}
              {%- if product.featured_image != blank -%}
                {{ product.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    widths: '360, 540, 720, 1000',
                    sizes: '(min-width: 990px) 28vw, 80vw',
                    loading: image_loading,
                    fetchpriority: image_priority,
                    alt: image_alt
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              <span>{{ product.title | escape }}</span>
            </a>
          {%- endfor -%}
        {%- else -%}
          <div class="if-about__image if-about__image--1">
            {{ 'product-1' | placeholder_svg_tag: 'if-about__placeholder placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="if-about__story page-width">
    <div>
      <p class="if-eyebrow if-eyebrow--dark">Our point of view</p>
      <h2>Good fabric should feel easy to choose.</h2>
    </div>
    <div class="if-about__story-copy rte">
      <p>Intikhab Fabrics presents premium men's unstitched fabric with the details that matter: season, composition, shade, cut length and price.</p>
      <p>Our focus is straightforward - dependable comfort, a refined drape and timeless colours that work beyond a single occasion.</p>
    </div>
  </div>

  <div class="if-about__values page-width" aria-label="What guides Intikhab Fabrics">
    <article>
      <span aria-hidden="true">01</span>
      <h2>Clear choices</h2>
      <p>Product information and options are organised so you can compare fabrics without guesswork.</p>
    </article>
    <article>
      <span aria-hidden="true">02</span>
      <h2>Season-ready comfort</h2>
      <p>Collections are selected around how a fabric feels, falls and performs in the season it is made for.</p>
    </article>
    <article>
      <span aria-hidden="true">03</span>
      <h2>Timeless character</h2>
      <p>Understated weaves and considered shades make each cut easier to wear, style and revisit.</p>
    </article>
  </div>

  {%- if featured_collection != blank -%}
    <div class="if-about__collection page-width">
      <div>
        <p class="if-eyebrow if-eyebrow--dark">Current collection</p>
        <h2>{{ featured_collection.title | escape }}</h2>
        {%- if featured_collection.description != blank -%}
          <div class="rte">{{ featured_collection.description | strip_html | truncatewords: 38 }}</div>
        {%- else -%}
          <p>Explore the latest articles, available shades and cut-length options in one place.</p>
        {%- endif -%}
      </div>
      <a class="if-button if-button--navy" href="{{ featured_collection.url }}">View collection <span aria-hidden="true">&rarr;</span></a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Intikhab about",
  "tag": "section",
  "class": "section-intikhab-about",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ABOUT INTIKHAB FABRICS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fabric chosen for how men actually dress."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Premium unstitched suiting, presented with clarity and selected for comfort, character and a confident drape.</p>"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop button link"
    }
  ],
  "presets": [
    {
      "name": "Intikhab about"
    }
  ]
}
{% endschema %}

<section class="if-contact" aria-labelledby="if-contact-title-{{ section.id }}">
  <div class="if-contact__shell page-width">
    <div class="if-contact__intro">
      <p class="if-eyebrow if-eyebrow--dark">CUSTOMER CARE</p>
      <h1 id="if-contact-title-{{ section.id }}">How can we help?</h1>
      <p class="if-contact__lead">Questions about a fabric, cut length, payment or an existing order? Send us a message and include your order number when relevant.</p>

      <div class="if-contact__channels">
        <a href="https://wa.me/923054281115" target="_blank" rel="noopener">
          <span class="if-contact__channel-icon" aria-hidden="true">W</span>
          <span><strong>WhatsApp</strong><small>+92 305 4281115</small></span>
        </a>
        <a href="tel:+923054281115">
          <span class="if-contact__channel-icon" aria-hidden="true">P</span>
          <span><strong>Phone</strong><small>+92 305 4281115</small></span>
        </a>
        <a href="mailto:intikhabfabrics@gmail.com">
          <span class="if-contact__channel-icon" aria-hidden="true">E</span>
          <span><strong>Email</strong><small>intikhabfabrics@gmail.com</small></span>
        </a>
      </div>

      <div class="if-contact__note">
        <strong>Before you message</strong>
        <p>For order support, share your order number and the phone number used at checkout. Never send card details or passwords.</p>
      </div>
    </div>

    <div class="if-contact__form-card">
      <h2>Send a message</h2>
      <p>Fields marked with * are required.</p>

      {%- form 'contact', id: 'IntikhabContactForm', class: 'if-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="if-form-status if-form-status--success" role="status" aria-live="polite" tabindex="-1">
            Thank you. Your message has been sent successfully.
          </div>
        {%- elsif form.errors -%}
          <div class="if-form-status if-form-status--error" role="alert" tabindex="-1">
            <p>Please check the highlighted details and try again.</p>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="if-contact__field-grid">
          <div class="if-contact__field">
            <label for="ContactFormName-{{ section.id }}">Full name</label>
            <input
              id="ContactFormName-{{ section.id }}"
              type="text"
              name="contact[name]"
              value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
              autocomplete="name"
              placeholder="Your full name"
            >
          </div>

          <div class="if-contact__field">
            <label for="ContactFormPhone-{{ section.id }}">Phone number</label>
            <input
              id="ContactFormPhone-{{ section.id }}"
              type="tel"
              name="contact[phone]"
              value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
              autocomplete="tel"
              inputmode="tel"
              placeholder="03XX XXXXXXX"
            >
          </div>
        </div>

        <div class="if-contact__field">
          <label for="ContactFormEmail-{{ section.id }}">Email address *</label>
          <input
            id="ContactFormEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            aria-required="true"
            {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="ContactFormEmailError-{{ section.id }}"{% endif %}
            placeholder="you@example.com"
          >
          {%- if form.errors contains 'email' -%}
            <small id="ContactFormEmailError-{{ section.id }}" class="if-contact__error">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </small>
          {%- endif -%}
        </div>

        <div class="if-contact__field">
          <label for="ContactFormOrder-{{ section.id }}">Order number <span>(optional)</span></label>
          <input
            id="ContactFormOrder-{{ section.id }}"
            type="text"
            name="contact[order_number]"
            placeholder="Example: #1024"
          >
        </div>

        <div class="if-contact__field">
          <label for="ContactFormBody-{{ section.id }}">How can we help? *</label>
          <textarea
            id="ContactFormBody-{{ section.id }}"
            rows="7"
            name="contact[body]"
            required
            aria-required="true"
            placeholder="Tell us what you need help with"
          >{{ form.body | escape }}</textarea>
        </div>

        <button class="if-button if-button--navy" type="submit">Send message <span aria-hidden="true">&rarr;</span></button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Intikhab contact",
  "tag": "section",
  "class": "section-intikhab-contact",
  "settings": [],
  "presets": [
    {
      "name": "Intikhab contact"
    }
  ]
}
{% endschema %}

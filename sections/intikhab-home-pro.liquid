{%- liquid
  assign winter_collection = section.settings.winter_collection
  if winter_collection == blank
    assign winter_collection = collections['winter-collection']
  endif

  assign primary_url = section.settings.primary_link
  if primary_url == blank and winter_collection != blank
    assign primary_url = winter_collection.url
  endif
  if primary_url == blank
    assign primary_url = routes.all_products_collection_url
  endif

  assign secondary_url = section.settings.secondary_link
  if secondary_url == blank
    assign secondary_url = routes.all_products_collection_url
  endif
-%}

<section class="if-home-pro" aria-labelledby="if-home-title-{{ section.id }}">
  <div class="if-hero">
    <div class="if-hero__inner page-width">
      <div class="if-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="if-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h1 id="if-home-title-{{ section.id }}" class="if-hero__title">
          {{ section.settings.heading | escape }}
        </h1>

        {%- if section.settings.text != blank -%}
          <div class="if-hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        <div class="if-hero__actions">
          <a class="if-button if-button--gold" href="{{ primary_url }}">
            {{ section.settings.primary_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
          <a class="if-button if-button--ghost" href="{{ secondary_url }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        </div>

        <dl class="if-hero__facts" aria-label="Winter collection highlights">
          <div>
            <dt>3</dt>
            <dd>Refined articles</dd>
          </div>
          <div>
            <dt>10</dt>
            <dd>Signature shades</dd>
          </div>
          <div>
            <dt>4–6m</dt>
            <dd>Cut length options</dd>
          </div>
        </dl>
      </div>

      <div class="if-hero__gallery" aria-label="Featured winter fabrics">
        {%- if winter_collection != blank and winter_collection.products_count > 0 -%}
          {%- for product in winter_collection.products limit: 3 -%}
            {%- assign hero_alt = product.featured_image.alt | default: product.title -%}
            {%- assign hero_loading = 'lazy' -%}
            {%- assign hero_priority = 'auto' -%}
            {%- if forloop.first -%}
              {%- assign hero_loading = 'eager' -%}
              {%- assign hero_priority = 'high' -%}
            {%- endif -%}
            <a
              class="if-hero-card if-hero-card--{{ forloop.index }}"
              href="{{ product.url }}"
              aria-label="View {{ product.title | escape }}"
            >
              {%- if product.featured_image != blank -%}
                {{ product.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'if-hero-card__image',
                    widths: '360, 540, 720, 900, 1200',
                    sizes: '(min-width: 990px) 38vw, 88vw',
                    loading: hero_loading,
                    fetchpriority: hero_priority,
                    alt: hero_alt
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'if-hero-card__image placeholder-svg' }}
              {%- endif -%}
              <span class="if-hero-card__shade">{{ product.title | escape }}</span>
            </a>
          {%- endfor -%}
        {%- else -%}
          <div class="if-hero-card if-hero-card--1 if-hero-card--placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'if-hero-card__image placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="if-trust" aria-label="Shopping benefits">
    <div class="if-trust__inner page-width">
      <div class="if-trust__item">
        <span class="if-trust__icon" aria-hidden="true">✓</span>
        <span><strong>Free delivery</strong><small>Nationwide</small></span>
      </div>
      <div class="if-trust__item">
        <span class="if-trust__icon" aria-hidden="true">✓</span>
        <span><strong>Cash on delivery</strong><small>Across Pakistan</small></span>
      </div>
      <div class="if-trust__item">
        <span class="if-trust__icon" aria-hidden="true">5%</span>
        <span><strong>Advance payment saving</strong><small>Use code EXTRA5</small></span>
      </div>
      <div class="if-trust__item">
        <span class="if-trust__icon" aria-hidden="true">14</span>
        <span><strong>Return or exchange request</strong><small>Within 14 days</small></span>
      </div>
    </div>
  </div>

  {%- if winter_collection != blank and winter_collection.products_count > 0 -%}
    <div class="if-home-section if-home-section--products page-width">
      <div class="if-section-heading">
        <div>
          <p class="if-eyebrow if-eyebrow--dark">The Winter Edit</p>
          <h2>Choose your article, shade and cut</h2>
          <p>Three distinct winter fabrics, presented clearly so you can compare feel, weave and price without confusion.</p>
        </div>
        <a class="if-text-link" href="{{ winter_collection.url }}">View the complete collection <span aria-hidden="true">→</span></a>
      </div>

      <div class="if-product-grid">
        {%- for product in winter_collection.products limit: 6 -%}
          {%- assign product_alt = product.featured_image.alt | default: product.title -%}
          <article class="if-product-card">
            <a class="if-product-card__media" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'if-product-card__image',
                    widths: '320, 480, 640, 800, 1000',
                    sizes: '(min-width: 990px) 30vw, 50vw',
                    loading: 'lazy',
                    alt: product_alt
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'if-product-card__image placeholder-svg' }}
              {%- endif -%}
              <span class="if-product-card__badge">
                {%- if product.available -%}Winter 2026{%- else -%}Sold out{%- endif -%}
              </span>
            </a>
            <div class="if-product-card__body">
              <p class="if-product-card__kicker">Unstitched men's fabric</p>
              <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              <div class="if-product-card__meta">
                <span>
                  {%- if product.price_varies -%}From {% endif -%}{{ product.price_min | money }}
                </span>
                <a href="{{ product.url }}">Select options <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="if-home-section if-home-section--categories page-width">
    <div class="if-section-heading if-section-heading--center">
      <div>
        <p class="if-eyebrow if-eyebrow--dark">Shop by fabric</p>
        <h2>A fabric for every season and occasion</h2>
        <p>Move from everyday comfort to formal refinement through focused, easy-to-browse collections.</p>
      </div>
    </div>

    <div class="if-category-grid">
      {%- assign category_handles = 'winter-collection,cotton-soft-finish,wash-wear,boski' | split: ',' -%}
      {%- for category_handle in category_handles -%}
        {%- assign category = collections[category_handle] -%}
        {%- if category != blank -%}
          {%- assign category_image = category.featured_image | default: category.products.first.featured_image -%}
          {%- assign category_alt = category_image.alt | default: category.title -%}
          <a class="if-category-card" href="{{ category.url }}">
            <span class="if-category-card__media">
              {%- if category_image != blank -%}
                {{ category_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'if-category-card__image',
                    widths: '320, 480, 640, 800, 900',
                    sizes: '(min-width: 990px) 23vw, 50vw',
                    loading: 'lazy',
                    alt: category_alt
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'if-category-card__image placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="if-category-card__content">
              <strong>{{ category.title | escape }}</strong>
              <span>Explore collection <span aria-hidden="true">→</span></span>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="if-home-section if-home-section--guide">
    <div class="if-guide page-width">
      <div class="if-guide__intro">
        <p class="if-eyebrow">A simpler way to buy fabric</p>
        <h2>From article to cut length in three clear steps</h2>
        <p>Each article stays on one product page. Choose the shade and required cut length there, then review the exact price before adding it to cart.</p>
        <a class="if-button if-button--gold" href="{{ primary_url }}">Start with Winter 2026 <span aria-hidden="true">→</span></a>
      </div>
      <ol class="if-guide__steps">
        <li><span>01</span><div><strong>Choose the article</strong><p>Compare fabric character, weave, width and starting price.</p></div></li>
        <li><span>02</span><div><strong>Select your shade</strong><p>See the available colours without opening duplicate product pages.</p></div></li>
        <li><span>03</span><div><strong>Pick the cut length</strong><p>Select 4, 4.5, 5, 5.5 or 6 metres and see the matching price.</p></div></li>
      </ol>
    </div>
  </div>

  <div class="if-home-section if-home-section--promise page-width">
    <div class="if-promise">
      <div class="if-promise__content">
        <p class="if-eyebrow if-eyebrow--dark">The Intikhab standard</p>
        <h2>{{ section.settings.promise_heading | escape }}</h2>
        <div class="rte">{{ section.settings.promise_text }}</div>
        <a class="if-text-link" href="{{ section.settings.promise_link | default: routes.all_products_collection_url }}">
          {{ section.settings.promise_label | escape }} <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="if-promise__details" aria-label="Intikhab service standards">
        <div><strong>Clear product options</strong><span>Article, colour and cut length shown before checkout.</span></div>
        <div><strong>Real product media</strong><span>Shade-specific fabric photos and detail videos where available.</span></div>
        <div><strong>Human support</strong><span>WhatsApp assistance remains available if you need help choosing.</span></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Intikhab premium home",
  "tag": "section",
  "class": "section section-intikhab-home-pro",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WINTER 2026 · AVT & PVT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Warmth, character and a better drape."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Explore ten considered winter shades across three unstitched articles, with clear cut-length options and pricing.</p>"
    },
    {
      "type": "collection",
      "id": "winter_collection",
      "label": "Winter collection"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop Winter Collection"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Explore All Fabrics"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "promise_heading",
      "label": "Promise heading",
      "default": "Premium fabric, presented with clarity."
    },
    {
      "type": "richtext",
      "id": "promise_text",
      "label": "Promise text",
      "default": "<p>Intikhab Fabrics brings together comfort, dependable quality and timeless colour for the modern gentleman.</p>"
    },
    {
      "type": "text",
      "id": "promise_label",
      "label": "Promise link label",
      "default": "Explore all collections"
    },
    {
      "type": "url",
      "id": "promise_link",
      "label": "Promise link"
    }
  ],
  "presets": [
    {
      "name": "Intikhab premium home"
    }
  ]
}
{% endschema %}

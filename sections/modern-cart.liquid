{% comment %}
  Modern cart section.

  The cart-items element and line-item attributes intentionally mirror
  Shopify's native cart.js contract. A small scoped adapter at the end of the
  section lets one OS 2.0 section update both the line-item list and summary
  through the Section Rendering API.
{% endcomment %}

{%- liquid
  assign free_shipping_threshold = section.settings.free_shipping_threshold | times: 100
  assign shipping_progress = 0
  if free_shipping_threshold > 0
    assign shipping_progress = cart.total_price | times: 100 | divided_by: free_shipping_threshold | at_most: 100
  endif
-%}

<section id="ModernCart-{{ section.id }}" class="modern-cart-section section-{{ section.id }}-padding">
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>

  <cart-items
    id="main-cart-items"
    class="modern-cart__items{% if cart == empty %} is-empty{% endif %}"
    data-id="{{ section.id }}"
    data-modern-cart
    data-modern-section-id="{{ section.id }}"
  >
    <div class="modern-cart__items-content">
      <header class="modern-cart__header">
        <div>
          <p class="modern-cart__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h1 class="modern-cart__title">{{ section.settings.heading | escape }}</h1>
        </div>
        <a class="modern-cart__continue" href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}">
          {{ section.settings.continue_label | escape }}
          <span aria-hidden="true">↗</span>
        </a>
      </header>

      <div class="cart__warnings modern-cart__empty" role="status">
        <div class="modern-cart__empty-mark" aria-hidden="true">□</div>
        <h2>{{ section.settings.empty_heading | escape }}</h2>
        <p>{{ section.settings.empty_copy | escape }}</p>
        <a href="{{ section.settings.continue_link | default: routes.all_products_collection_url }}" class="modern-cart__button button button--primary">
          {{ section.settings.empty_button | escape }}
        </a>
        {%- if shop.customer_accounts_enabled and customer == null -%}
          <p class="modern-cart__login-copy">
            {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
          </p>
        {%- endif -%}
      </div>

      <form action="{{ routes.cart_url }}" class="modern-cart__form cart__contents{% if cart == empty %} critical-hidden{% endif %}" method="post" id="cart">
        <div class="modern-cart__list" role="list" aria-label="{{ 'sections.cart.title' | t }}">
          {%- if cart != empty -%}
            {%- for item in cart.items -%}
              <article class="modern-cart__line cart-item" id="CartItem-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}" role="listitem">
                <div class="modern-cart__line-media">
                  {%- if item.image -%}
                    {%- assign item_image_alt = item.image.alt | default: item.product.title -%}
                    <a href="{{ item.url }}" class="modern-cart__line-link" aria-label="{{ item.product.title | escape }}">
                      {{ item.image | image_url: width: 440 | image_tag: loading: 'lazy', widths: '220, 330, 440', class: 'modern-cart__line-image', alt: item_image_alt }}
                    </a>
                  {%- else -%}
                    <div class="modern-cart__line-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                  {%- endif -%}
                </div>

                <div class="modern-cart__line-details">
                  {%- if item.product.vendor != blank -%}
                    <p class="modern-cart__line-vendor">{{ item.product.vendor | escape }}</p>
                  {%- endif -%}
                  <a href="{{ item.url }}" class="modern-cart__line-title">{{ item.product.title | escape }}</a>

                  {%- if item.product.has_only_default_variant == false -%}
                    <dl class="modern-cart__line-options">
                      {%- for option in item.options_with_values -%}
                        <div><dt>{{ option.name | escape }}</dt><dd>{{ option.value | escape }}</dd></div>
                      {%- endfor -%}
                    </dl>
                  {%- endif -%}

                  {%- for property in item.properties -%}
                    {%- assign property_first_char = property.first | slice: 0 -%}
                    {%- if property.last != blank and property_first_char != '_' -%}
                      <dl class="modern-cart__line-options"><div><dt>{{ property.first | escape }}</dt><dd>{{ property.last | escape }}</dd></div></dl>
                    {%- endif -%}
                  {%- endfor -%}

                  {%- if item.discounts.size > 0 -%}
                    <ul class="modern-cart__line-discounts" role="list">
                      {%- for discount in item.discounts -%}
                        <li>{{ discount.title | escape }}</li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                  <div class="modern-cart__line-controls">
                    <quantity-input class="modern-cart__quantity quantity cart-quantity">
                      <button class="quantity__button" name="minus" type="button" aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}">−</button>
                      <input
                        class="quantity__input"
                        data-quantity-variant-id="{{ item.variant.id }}"
                        type="number"
                        name="updates[]"
                        value="{{ item.quantity }}"
                        min="{{ item.variant.quantity_rule.min }}"
                        {% if item.variant.quantity_rule.max != null %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                        step="{{ item.variant.quantity_rule.increment }}"
                        data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                        data-index="{{ item.index | plus: 1 }}"
                        id="Quantity-{{ item.index | plus: 1 }}"
                        aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                      >
                      <button class="quantity__button" name="plus" type="button" aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}">+</button>
                    </quantity-input>
                    <cart-remove-button class="modern-cart__remove" data-index="{{ item.index | plus: 1 }}">
                      <button type="button" aria-label="{{ 'sections.cart.remove_title' | t: title: item.product.title | escape }}">{{ section.settings.remove_label | escape }}</button>
                    </cart-remove-button>
                  </div>
                  <div class="cart-item__error modern-cart__line-error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                    <span class="cart-item__error-text"></span>
                  </div>
                </div>

                <div class="modern-cart__line-total">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <s>
                      {%- if settings.currency_code_enabled -%}{{ item.original_line_price | money_with_currency }}{%- else -%}{{ item.original_line_price | money }}{%- endif -%}
                    </s>
                  {%- endif -%}
                  <strong>
                    {%- if settings.currency_code_enabled -%}{{ item.final_line_price | money_with_currency }}{%- else -%}{{ item.final_line_price | money }}{%- endif -%}
                  </strong>
                  {%- if item.unit_price_measurement -%}
                    <small>
                      {%- if settings.currency_code_enabled -%}{{ item.unit_price | money_with_currency }}{%- else -%}{{ item.unit_price | money }}{%- endif -%}
                      / {{ item.unit_price_measurement.reference_value }}{{ item.unit_price_measurement.reference_unit | escape }}
                    </small>
                  {%- endif -%}
                </div>

                <div class="loading-overlay hidden" aria-hidden="true">
                  <span class="loading-overlay__spinner"><svg class="spinner" viewBox="0 0 66 66" role="presentation"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg></span>
                </div>
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>

      </form>
      <p id="cart-errors" class="modern-cart__errors" role="alert" aria-live="polite"></p>
    </div>
    <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status" aria-hidden="true"></p>
    <p class="visually-hidden" id="shopping-cart-line-item-status" aria-live="polite" aria-hidden="true" role="status">{{ 'accessibility.loading' | t }}</p>
  </cart-items>

  <aside id="main-cart-footer" class="modern-cart__summary{% if cart == empty %} is-empty{% endif %}" data-id="{{ section.id }}">
    <div class="modern-cart__summary-content">
      {%- if free_shipping_threshold > 0 -%}
        <div class="modern-cart__shipping-progress">
          {%- if cart.total_price >= free_shipping_threshold -%}
            <strong>{{ section.settings.shipping_complete | escape }}</strong>
          {%- else -%}
            {%- assign remaining = free_shipping_threshold | minus: cart.total_price -%}
            <span>{{ section.settings.shipping_prefix | escape }} <strong>{% if settings.currency_code_enabled %}{{ remaining | money_with_currency }}{% else %}{{ remaining | money }}{% endif %}</strong> {{ section.settings.shipping_suffix | escape }}</span>
          {%- endif -%}
          <div class="modern-cart__progress" aria-hidden="true"><span style="width: {{ shipping_progress }}%"></span></div>
        </div>
      {%- endif -%}

      <div class="modern-cart__summary-card">
        <div class="modern-cart__summary-row">
          <span>{{ 'sections.cart.subtotal' | t }} <small>({{ cart.item_count }})</small></span>
          <strong>{% if settings.currency_code_enabled %}{{ cart.total_price | money_with_currency }}{% else %}{{ cart.total_price | money }}{% endif %}</strong>
        </div>

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul class="modern-cart__discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
            {%- for discount in cart.cart_level_discount_applications -%}
              <li>{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if settings.show_cart_note -%}
          <label class="modern-cart__note-label" for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea class="modern-cart__note" name="note" form="cart" id="Cart-note" placeholder="{{ section.settings.note_placeholder | escape }}">{{ cart.note }}</textarea>
        {%- endif -%}

        <p class="modern-cart__tax-note">
          {%- if cart.taxes_included -%}
            {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
          {%- else -%}
            {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
          {%- endif -%}
        </p>

        <button type="submit" name="checkout" class="modern-cart__checkout button button--primary" form="cart" {% if cart == empty %}disabled{% endif %}>
          {{ 'sections.cart.checkout' | t }}
          <span aria-hidden="true">→</span>
        </button>

        {%- if additional_checkout_buttons -%}
          <div class="modern-cart__accelerated">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}
      </div>

      <div class="modern-cart__reassurance" role="list">
        <span role="listitem">✓ {{ section.settings.reassurance_one | escape }}</span>
        <span role="listitem">✓ {{ section.settings.reassurance_two | escape }}</span>
      </div>
    </div>
  </aside>
</section>

{%- style -%}
  .modern-cart-section { --modern-cart-ink: #17213a; --modern-cart-muted: #6f788c; --modern-cart-line: rgba(23, 33, 58, .14); --modern-cart-soft: #f7f7f5; color: var(--modern-cart-ink); }
  .section-{{ section.id }}-padding { padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px; }
  .modern-cart-section { display: grid; gap: 30px; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); margin: 0 auto; max-width: {{ section.settings.max_width }}px; }
  .modern-cart__items, .modern-cart__summary { min-width: 0; }
  .modern-cart__items.is-empty { grid-column: 1 / -1; }
  .modern-cart__summary.is-empty { display: none; }
  .modern-cart__items-content { min-height: 300px; }
  .modern-cart__header { align-items: end; border-bottom: 1px solid var(--modern-cart-line); display: flex; justify-content: space-between; margin-bottom: 8px; padding-bottom: 26px; }
  .modern-cart__eyebrow { color: var(--modern-cart-muted); font-size: 11px; letter-spacing: .16em; margin: 0 0 10px; text-transform: uppercase; }
  .modern-cart__title { font-family: var(--font-heading-family, inherit); font-size: clamp(32px, 4vw, 58px); font-weight: 500; letter-spacing: -.04em; line-height: 1; margin: 0; }
  .modern-cart__continue { align-items: center; color: var(--modern-cart-ink); display: inline-flex; font-size: 13px; gap: 8px; text-decoration: none; }
  .modern-cart__continue:hover { text-decoration: underline; text-underline-offset: 4px; }
  .modern-cart__list { display: grid; }
  .modern-cart__line { border-bottom: 1px solid var(--modern-cart-line); display: grid; gap: 18px; grid-template-columns: 128px minmax(0, 1fr) auto; padding: 24px 0; position: relative; }
  .modern-cart__line-media { aspect-ratio: 1 / 1.15; background: var(--modern-cart-soft); border-radius: 12px; overflow: hidden; }
  .modern-cart__line-link, .modern-cart__line-image { display: block; height: 100%; width: 100%; }
  .modern-cart__line-image { object-fit: cover; transition: transform .35s ease; }
  .modern-cart__line-link:hover .modern-cart__line-image { transform: scale(1.04); }
  .modern-cart__line-placeholder { height: 100%; }
  .modern-cart__line-placeholder svg { height: 100%; width: 100%; }
  .modern-cart__line-details { min-width: 0; padding-top: 4px; }
  .modern-cart__line-vendor { color: var(--modern-cart-muted); font-size: 10px; letter-spacing: .13em; margin: 0 0 8px; text-transform: uppercase; }
  .modern-cart__line-title { color: var(--modern-cart-ink); display: block; font-size: 17px; font-weight: 600; line-height: 1.3; text-decoration: none; }
  .modern-cart__line-title:hover { text-decoration: underline; text-underline-offset: 3px; }
  .modern-cart__line-options { color: var(--modern-cart-muted); font-size: 12px; margin: 12px 0 0; }
  .modern-cart__line-options div { display: flex; gap: 6px; }
  .modern-cart__line-options dt::after { content: ':'; }
  .modern-cart__line-options dd { margin: 0; }
  .modern-cart__line-discounts { color: #386c49; font-size: 12px; list-style: none; margin: 10px 0 0; padding: 0; }
  .modern-cart__line-controls { align-items: center; display: flex; gap: 18px; margin-top: 22px; }
  .modern-cart__quantity { align-items: center; border: 1px solid var(--modern-cart-line); border-radius: 999px; display: inline-flex; min-height: 38px; }
  .modern-cart__quantity .quantity__button { background: transparent; border: 0; color: var(--modern-cart-ink); cursor: pointer; font-size: 18px; height: 36px; width: 34px; }
  .modern-cart__quantity .quantity__input { -moz-appearance: textfield; background: transparent; border: 0; color: var(--modern-cart-ink); font-size: 13px; text-align: center; width: 32px; }
  .modern-cart__quantity .quantity__input::-webkit-inner-spin-button, .modern-cart__quantity .quantity__input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .modern-cart__remove button { background: none; border: 0; color: var(--modern-cart-muted); cursor: pointer; font-size: 12px; padding: 4px 0; text-decoration: underline; text-underline-offset: 3px; }
  .modern-cart__line-total { display: flex; flex-direction: column; font-size: 15px; gap: 5px; padding-top: 5px; text-align: right; white-space: nowrap; }
  .modern-cart__line-total s { color: var(--modern-cart-muted); font-size: 12px; }
  .modern-cart__line-total small { color: var(--modern-cart-muted); font-size: 11px; }
  .modern-cart__line-error { color: #b42318; font-size: 12px; margin-top: 10px; }
  .modern-cart__line-error:empty { display: none; }
  .modern-cart__errors { color: #b42318; font-size: 12px; margin: 14px 0 0; }
  .modern-cart__errors:empty { display: none; }
  .modern-cart__summary { align-self: start; position: sticky; top: 28px; }
  .modern-cart__summary-content { display: grid; gap: 16px; }
  .modern-cart__shipping-progress { background: var(--modern-cart-soft); border-radius: 12px; color: var(--modern-cart-muted); font-size: 12px; line-height: 1.5; padding: 16px; }
  .modern-cart__shipping-progress strong { color: var(--modern-cart-ink); }
  .modern-cart__progress { background: rgba(23, 33, 58, .12); border-radius: 999px; height: 5px; margin-top: 12px; overflow: hidden; }
  .modern-cart__progress span { background: var(--modern-cart-ink); border-radius: inherit; display: block; height: 100%; transition: width .5s ease; }
  .modern-cart__summary-card { border: 1px solid var(--modern-cart-line); border-radius: 16px; padding: 24px; }
  .modern-cart__summary-row { align-items: baseline; display: flex; font-size: 14px; justify-content: space-between; }
  .modern-cart__summary-row small { color: var(--modern-cart-muted); font-size: 11px; }
  .modern-cart__summary-row strong { font-size: 20px; }
  .modern-cart__discounts { color: #386c49; font-size: 12px; list-style: none; margin: 14px 0 0; padding: 0; }
  .modern-cart__discounts li { display: flex; justify-content: space-between; }
  .modern-cart__note-label { color: var(--modern-cart-muted); display: block; font-size: 12px; margin: 22px 0 7px; }
  .modern-cart__note { border: 1px solid var(--modern-cart-line); border-radius: 8px; box-sizing: border-box; font: inherit; font-size: 13px; min-height: 82px; padding: 11px 12px; resize: vertical; width: 100%; }
  .modern-cart__tax-note { color: var(--modern-cart-muted); font-size: 11px; line-height: 1.5; margin: 18px 0; }
  .modern-cart__checkout { align-items: center; border-radius: 999px; display: flex; justify-content: space-between; min-height: 53px; padding: 0 20px; width: 100%; }
  .modern-cart__accelerated { margin-top: 10px; }
  .modern-cart__reassurance { color: var(--modern-cart-muted); display: grid; font-size: 12px; gap: 7px; padding: 4px 4px 0; }
  .modern-cart__empty { align-items: center; display: none; flex-direction: column; min-height: 320px; padding: 70px 20px; text-align: center; }
  .is-empty .modern-cart__empty { display: flex; }
  .is-empty .modern-cart__form { display: none; }
  .modern-cart__empty-mark { border: 1px solid var(--modern-cart-line); border-radius: 50%; color: var(--modern-cart-muted); font-size: 20px; height: 52px; line-height: 50px; margin-bottom: 18px; width: 52px; }
  .modern-cart__empty h2 { font-size: 24px; margin: 0 0 8px; }
  .modern-cart__empty p { color: var(--modern-cart-muted); font-size: 14px; margin: 0 0 22px; }
  .modern-cart__button { border-radius: 999px; min-height: 48px; }
  .modern-cart__login-copy { font-size: 12px !important; margin: 20px 0 0 !important; }
  @media screen and (max-width: 989px) {
    .modern-cart-section { grid-template-columns: minmax(0, 1fr) minmax(280px, .7fr); }
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding { padding: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px 16px {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px; }
    .modern-cart-section { display: block; }
    .modern-cart__header { align-items: start; flex-direction: column; gap: 18px; }
    .modern-cart__line { grid-template-columns: 88px minmax(0, 1fr); }
    .modern-cart__line-total { grid-column: 2; grid-row: 1; justify-self: end; }
    .modern-cart__line-details { grid-column: 2; grid-row: 1; padding-top: 52px; }
    .modern-cart__line-controls { margin-top: 16px; }
    .modern-cart__summary { margin-top: 28px; position: static; }
  }
{%- endstyle -%}

<script>
  (function () {
    function initModernCart() {
      var cartItems = document.querySelector('cart-items[data-modern-cart]');
      if (!cartItems || cartItems.dataset.modernCartReady === 'true') return;
      cartItems.dataset.modernCartReady = 'true';
      var sectionId = cartItems.dataset.modernSectionId;

      cartItems.getSectionsToRender = function () {
        return [
          { id: 'main-cart-items', section: sectionId, selector: '.modern-cart__items-content' },
          { id: 'main-cart-footer', section: sectionId, selector: '.modern-cart__summary-content' }
        ];
      };

      cartItems.onCartUpdate = function () {
        fetch((window.routes && window.routes.cart_url ? window.routes.cart_url : '/cart') + '?section_id=' + encodeURIComponent(sectionId))
          .then(function (response) { return response.text(); })
          .then(function (responseText) {
            var html = new DOMParser().parseFromString(responseText, 'text/html');
            var sourceItems = html.querySelector('.modern-cart__items-content');
            var sourceSummary = html.querySelector('.modern-cart__summary-content');
            var targetItems = document.querySelector('#main-cart-items .modern-cart__items-content');
            var targetSummary = document.querySelector('#main-cart-footer .modern-cart__summary-content');
            if (sourceItems && targetItems) targetItems.innerHTML = sourceItems.innerHTML;
            if (sourceSummary && targetSummary) targetSummary.innerHTML = sourceSummary.innerHTML;
            var itemCount = html.querySelector('#main-cart-items')?.classList.contains('is-empty');
            document.getElementById('main-cart-items')?.classList.toggle('is-empty', !!itemCount);
            document.getElementById('main-cart-footer')?.classList.toggle('is-empty', !!itemCount);
          })
          .catch(function (error) { console.error('Modern cart refresh failed', error); });
      };
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () {
        if (window.customElements && customElements.whenDefined) customElements.whenDefined('cart-items').then(initModernCart);
        else initModernCart();
      });
    } else if (window.customElements && customElements.whenDefined) {
      customElements.whenDefined('cart-items').then(initModernCart);
    } else {
      initModernCart();
    }
  })();
</script>

{% schema %}
{
  "name": "Modern cart",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your selection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shopping bag" },
    { "type": "text", "id": "continue_label", "label": "Continue shopping label", "default": "Continue shopping" },
    { "type": "url", "id": "continue_link", "label": "Continue shopping link" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Your bag is empty" },
    { "type": "text", "id": "empty_copy", "label": "Empty copy", "default": "Explore our latest fabrics and find something made for you." },
    { "type": "text", "id": "empty_button", "label": "Empty button label", "default": "Explore the collection" },
    { "type": "text", "id": "remove_label", "label": "Remove label", "default": "Remove" },
    { "type": "text", "id": "note_placeholder", "label": "Note placeholder", "default": "Add a note for your order" },
    { "type": "range", "id": "free_shipping_threshold", "label": "Free shipping threshold", "min": 0, "max": 50000, "step": 500, "default": 5000, "info": "Enter the amount in store currency. Set to 0 to hide the progress bar." },
    { "type": "text", "id": "shipping_prefix", "label": "Shipping progress prefix", "default": "You are" },
    { "type": "text", "id": "shipping_suffix", "label": "Shipping progress suffix", "default": "away from complimentary delivery" },
    { "type": "text", "id": "shipping_complete", "label": "Shipping complete message", "default": "Complimentary delivery unlocked" },
    { "type": "text", "id": "reassurance_one", "label": "Reassurance one", "default": "Secure checkout" },
    { "type": "text", "id": "reassurance_two", "label": "Reassurance two", "default": "Packed with care" },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 900, "max": 1800, "step": 20, "default": 1320, "unit": "px" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "default": 72, "unit": "px" }
  ],
  "presets": [{ "name": "Modern cart" }]
}
{% endschema %}

{%- liquid
  assign featured_collection = section.settings.featured_collection
  assign trust_blocks = section.blocks | where: 'type', 'trust'
  assign trust_columns = trust_blocks.size | at_most: 4
  if trust_columns < 1
    assign trust_columns = 1
  endif
  assign hero_link = section.settings.hero_primary_link
  assign secondary_link = section.settings.hero_secondary_link
  assign editorial_link = section.settings.editorial_link
  assign hero_alt = section.settings.hero_image.alt | default: section.settings.hero_heading | strip_html
-%}

{%- style -%}
  .modern-home-{{ section.id }} {
    --modern-home-bg: {{ section.settings.background_color }};
    --modern-home-surface: {{ section.settings.surface_color }};
    --modern-home-text: {{ section.settings.text_color }};
    --modern-home-muted: {{ section.settings.muted_color }};
    --modern-home-accent: {{ section.settings.accent_color }};
    --modern-home-accent-contrast: {{ section.settings.accent_contrast_color }};
    --modern-home-border: color-mix(in srgb, {{ section.settings.text_color }} 14%, transparent);
    background: var(--modern-home-bg);
    color: var(--modern-home-text);
    overflow: hidden;
    overflow: clip;
  }

  .modern-home-{{ section.id }} .modern-home__inner {
    width: calc(100% - 48px);
    max-width: 1280px;
    width: min(100% - 48px, 1280px);
    margin-inline: auto;
  }

  .modern-home-{{ section.id }} .modern-home__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: var(--modern-home-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .modern-home-{{ section.id }} .modern-home__eyebrow::before {
    width: 28px;
    height: 1px;
    background: var(--modern-home-accent);
    content: '';
  }

  .modern-home-{{ section.id }} .modern-home__hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(28px, 6vw, 96px);
    align-items: center;
    min-height: min(720px, calc(100svh - 88px));
    padding-block: {{ section.settings.hero_padding_top }}px {{ section.settings.hero_padding_bottom }}px;
  }

  .modern-home-{{ section.id }} .modern-home__hero-copy {
    max-width: 600px;
    {% if section.settings.hero_content_alignment == 'center' %}margin-inline: auto; text-align: center;{% endif %}
  }

  .modern-home-{{ section.id }} .modern-home__hero-copy .modern-home__eyebrow {
    {% if section.settings.hero_content_alignment == 'center' %}justify-content: center;{% endif %}
  }

  .modern-home-{{ section.id }} .modern-home__hero-title {
    max-width: 12ch;
    margin: 0;
    color: var(--modern-home-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(2.9rem, 6.2vw, 6.65rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .modern-home-{{ section.id }} .modern-home__hero-title em {
    color: var(--modern-home-accent);
    font-style: normal;
  }

  .modern-home-{{ section.id }} .modern-home__hero-body {
    max-width: 500px;
    margin: 26px 0 0;
    color: var(--modern-home-muted);
    font-size: clamp(1rem, 1.3vw, 1.16rem);
    line-height: 1.75;
  }

  .modern-home-{{ section.id }} .modern-home__hero-body p {
    margin: 0;
  }

  .modern-home-{{ section.id }} .modern-home__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
  }

  .modern-home-{{ section.id }} .modern-home__button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 14px 22px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--modern-home-accent);
    color: var(--modern-home-accent-contrast);
    font-size: 0.79rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .modern-home-{{ section.id }} .modern-home__button:hover {
    background: var(--modern-home-text);
    color: var(--modern-home-bg);
    transform: translateY(-2px);
  }

  .modern-home-{{ section.id }} .modern-home__button:focus-visible,
  .modern-home-{{ section.id }} a:focus-visible {
    outline: 2px solid var(--modern-home-accent);
    outline-offset: 4px;
  }

  .modern-home-{{ section.id }} .modern-home__button--secondary {
    border-color: var(--modern-home-border);
    background: transparent;
    color: var(--modern-home-text);
  }

  .modern-home-{{ section.id }} .modern-home__button--secondary:hover {
    border-color: var(--modern-home-text);
    background: transparent;
    color: var(--modern-home-text);
  }

  .modern-home-{{ section.id }} .modern-home__arrow {
    display: inline-grid;
    width: 18px;
    height: 18px;
    place-items: center;
    transition: transform 180ms ease;
  }

  .modern-home-{{ section.id }} .modern-home__button:hover .modern-home__arrow,
  .modern-home-{{ section.id }} .modern-home__text-link:hover .modern-home__arrow {
    transform: translateX(3px);
  }

  .modern-home-{{ section.id }} .modern-home__hero-media {
    position: relative;
    min-height: clamp(390px, 55vw, 680px);
    overflow: hidden;
    border-radius: 4px;
    background: linear-gradient(145deg, #d9dedb 0%, #aebdb6 46%, #5f756d 100%);
  }

  .modern-home-{{ section.id }} .modern-home__hero-media::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 52%, rgba(12, 27, 24, 0.32) 100%);
    content: '';
    pointer-events: none;
  }

  .modern-home-{{ section.id }} .modern-home__hero-media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(390px, 55vw, 680px);
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.65, 0.2, 1);
  }

  .modern-home-{{ section.id }} .modern-home__hero-media:hover img {
    transform: scale(1.035);
  }

  .modern-home-{{ section.id }} .modern-home__hero-note {
    position: absolute;
    z-index: 1;
    right: 22px;
    bottom: 22px;
    max-width: 190px;
    padding: 13px 15px;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 2px;
    background: rgba(15, 30, 27, 0.32);
    color: #fff;
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    line-height: 1.45;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
  }

  .modern-home-{{ section.id }} .modern-home__section {
    padding-block: {{ section.settings.section_padding }}px;
  }

  .modern-home-{{ section.id }} .modern-home__section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .modern-home-{{ section.id }} .modern-home__section-title {
    max-width: 630px;
    margin: 0;
    color: var(--modern-home-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(2rem, 3.8vw, 3.65rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1;
    text-wrap: balance;
  }

  .modern-home-{{ section.id }} .modern-home__section-intro {
    max-width: 420px;
    margin: 12px 0 0;
    color: var(--modern-home-muted);
    font-size: 0.96rem;
    line-height: 1.7;
  }

  .modern-home-{{ section.id }} .modern-home__section-intro p {
    margin: 0;
  }

  .modern-home-{{ section.id }} .modern-home__text-link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 9px;
    color: var(--modern-home-text);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .modern-home-{{ section.id }} .modern-home__collection-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .modern-home-{{ section.id }} .modern-home__collection-card {
    position: relative;
    min-height: 390px;
    overflow: hidden;
    border-radius: 3px;
    background: var(--modern-home-surface);
  }

  .modern-home-{{ section.id }} .modern-home__collection-card::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 38%, rgba(12, 27, 24, 0.72) 100%);
    content: '';
    pointer-events: none;
  }

  .modern-home-{{ section.id }} .modern-home__collection-card img,
  .modern-home-{{ section.id }} .modern-home__collection-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 390px;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.2, 0.65, 0.2, 1);
  }

  .modern-home-{{ section.id }} .modern-home__collection-placeholder {
    background: linear-gradient(145deg, #d8d9d3, #86968e);
  }

  .modern-home-{{ section.id }} .modern-home__collection-card:hover img,
  .modern-home-{{ section.id }} .modern-home__collection-card:hover .modern-home__collection-placeholder {
    transform: scale(1.045);
  }

  .modern-home-{{ section.id }} .modern-home__collection-content {
    position: absolute;
    z-index: 1;
    right: 22px;
    bottom: 20px;
    left: 22px;
    color: #fff;
  }

  .modern-home-{{ section.id }} .modern-home__collection-kicker {
    margin: 0 0 8px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    opacity: 0.82;
    text-transform: uppercase;
  }

  .modern-home-{{ section.id }} .modern-home__collection-title {
    margin: 0;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(1.35rem, 2vw, 1.95rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .modern-home-{{ section.id }} .modern-home__collection-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 13px;
    color: #fff;
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .modern-home-{{ section.id }} .modern-home__trust {
    border-block: 1px solid var(--modern-home-border);
    background: color-mix(in srgb, var(--modern-home-surface) 50%, transparent);
  }

  .modern-home-{{ section.id }} .modern-home__trust-grid {
    display: grid;
    grid-template-columns: repeat({{ trust_columns }}, minmax(0, 1fr));
  }

  .modern-home-{{ section.id }} .modern-home__trust-item {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 92px;
    padding: 17px 24px;
    border-inline-start: 1px solid var(--modern-home-border);
  }

  .modern-home-{{ section.id }} .modern-home__trust-item:first-child {
    border-inline-start: 0;
    padding-inline-start: 0;
  }

  .modern-home-{{ section.id }} .modern-home__trust-icon {
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    place-items: center;
    border: 1px solid var(--modern-home-border);
    border-radius: 50%;
    color: var(--modern-home-accent);
  }

  .modern-home-{{ section.id }} .modern-home__trust-icon svg {
    width: 17px;
    height: 17px;
  }

  .modern-home-{{ section.id }} .modern-home__trust-title {
    margin: 0;
    color: var(--modern-home-text);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .modern-home-{{ section.id }} .modern-home__trust-copy {
    margin: 4px 0 0;
    color: var(--modern-home-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .modern-home-{{ section.id }} .modern-home__product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .modern-home-{{ section.id }} .modern-home__product-card {
    min-width: 0;
  }

  .modern-home-{{ section.id }} .modern-home__product-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 0.82;
    background: var(--modern-home-surface);
  }

  .modern-home-{{ section.id }} .modern-home__product-media img,
  .modern-home-{{ section.id }} .modern-home__product-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.2, 0.65, 0.2, 1);
  }

  .modern-home-{{ section.id }} .modern-home__product-placeholder {
    background: linear-gradient(145deg, #e7e5de, #c0c4bc);
  }

  .modern-home-{{ section.id }} .modern-home__product-card:hover .modern-home__product-media img,
  .modern-home-{{ section.id }} .modern-home__product-card:hover .modern-home__product-placeholder {
    transform: scale(1.04);
  }

  .modern-home-{{ section.id }} .modern-home__product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 7px 9px;
    background: var(--modern-home-accent);
    color: var(--modern-home-accent-contrast);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .modern-home-{{ section.id }} .modern-home__product-info {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 10px;
    padding-top: 14px;
  }

  .modern-home-{{ section.id }} .modern-home__product-title {
    margin: 0;
    color: var(--modern-home-text);
    font-size: 0.93rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .modern-home-{{ section.id }} .modern-home__product-title a {
    color: inherit;
    text-decoration: none;
  }

  .modern-home-{{ section.id }} .modern-home__product-price {
    flex: 0 0 auto;
    color: var(--modern-home-muted);
    font-size: 0.86rem;
    white-space: nowrap;
  }

  .modern-home-{{ section.id }} .modern-home__editorial {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    background: var(--modern-home-surface);
  }

  .modern-home-{{ section.id }} .modern-home__editorial-media {
    min-height: 460px;
    overflow: hidden;
  }

  .modern-home-{{ section.id }} .modern-home__editorial-media img,
  .modern-home-{{ section.id }} .modern-home__editorial-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 460px;
    object-fit: cover;
  }

  .modern-home-{{ section.id }} .modern-home__editorial-placeholder {
    background: linear-gradient(135deg, #d9dbd4, #899b91);
  }

  .modern-home-{{ section.id }} .modern-home__editorial-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(34px, 7vw, 92px);
  }

  .modern-home-{{ section.id }} .modern-home__editorial-title {
    max-width: 11ch;
    margin: 0;
    color: var(--modern-home-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(2.2rem, 4.5vw, 4.55rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .modern-home-{{ section.id }} .modern-home__editorial-text {
    max-width: 440px;
    margin: 22px 0 0;
    color: var(--modern-home-muted);
    line-height: 1.75;
  }

  .modern-home-{{ section.id }} .modern-home__editorial-text p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .modern-home-{{ section.id }} .modern-home__hero {
      gap: 38px;
    }

    .modern-home-{{ section.id }} .modern-home__collection-grid,
    .modern-home-{{ section.id }} .modern-home__product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .modern-home-{{ section.id }} .modern-home__collection-card,
    .modern-home-{{ section.id }} .modern-home__collection-card img,
    .modern-home-{{ section.id }} .modern-home__collection-placeholder {
      min-height: 330px;
    }

    .modern-home-{{ section.id }} .modern-home__trust-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .modern-home-{{ section.id }} .modern-home__trust-item:nth-child(3) {
      border-inline-start: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .modern-home-{{ section.id }} .modern-home__inner {
      width: calc(100% - 32px);
      max-width: 640px;
      width: min(100% - 32px, 640px);
    }

    .modern-home-{{ section.id }} .modern-home__hero {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      padding-block: 48px 32px;
    }

    .modern-home-{{ section.id }} .modern-home__hero-copy {
      max-width: none;
      text-align: left;
    }

    .modern-home-{{ section.id }} .modern-home__hero-copy .modern-home__eyebrow {
      justify-content: flex-start;
    }

    .modern-home-{{ section.id }} .modern-home__hero-title {
      max-width: 10ch;
      font-size: clamp(2.9rem, 13vw, 4.7rem);
    }

    .modern-home-{{ section.id }} .modern-home__hero-media,
    .modern-home-{{ section.id }} .modern-home__hero-media img {
      min-height: 430px;
    }

    .modern-home-{{ section.id }} .modern-home__section {
      padding-block: 48px;
    }

    .modern-home-{{ section.id }} .modern-home__section-head {
      display: block;
      margin-bottom: 22px;
    }

    .modern-home-{{ section.id }} .modern-home__section-head .modern-home__text-link {
      margin-top: 18px;
    }

    .modern-home-{{ section.id }} .modern-home__collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .modern-home-{{ section.id }} .modern-home__collection-card,
    .modern-home-{{ section.id }} .modern-home__collection-card img,
    .modern-home-{{ section.id }} .modern-home__collection-placeholder {
      min-height: 250px;
    }

    .modern-home-{{ section.id }} .modern-home__collection-content {
      right: 14px;
      bottom: 14px;
      left: 14px;
    }

    .modern-home-{{ section.id }} .modern-home__collection-title {
      font-size: 1.25rem;
    }

    .modern-home-{{ section.id }} .modern-home__trust-grid {
      grid-template-columns: 1fr;
    }

    .modern-home-{{ section.id }} .modern-home__trust-item,
    .modern-home-{{ section.id }} .modern-home__trust-item:nth-child(3) {
      min-height: 78px;
      border-block-start: 1px solid var(--modern-home-border);
      border-inline-start: 0;
      padding-inline: 0;
    }

    .modern-home-{{ section.id }} .modern-home__trust-item:first-child {
      border-block-start: 0;
    }

    .modern-home-{{ section.id }} .modern-home__product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 10px;
    }

    .modern-home-{{ section.id }} .modern-home__product-info {
      display: block;
    }

    .modern-home-{{ section.id }} .modern-home__product-price {
      display: block;
      margin-top: 5px;
    }

    .modern-home-{{ section.id }} .modern-home__editorial {
      grid-template-columns: 1fr;
    }

    .modern-home-{{ section.id }} .modern-home__editorial-media,
    .modern-home-{{ section.id }} .modern-home__editorial-media img,
    .modern-home-{{ section.id }} .modern-home__editorial-placeholder {
      min-height: 300px;
    }

    .modern-home-{{ section.id }} .modern-home__editorial-copy {
      padding: 42px 26px 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modern-home-{{ section.id }} *,
    .modern-home-{{ section.id }} *::before,
    .modern-home-{{ section.id }} *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
{%- endstyle -%}

<div class="modern-home-{{ section.id }}">
  <div class="modern-home__inner">
    <section class="modern-home__hero" aria-labelledby="ModernHomeHero-{{ section.id }}">
      <div class="modern-home__hero-copy">
        {%- if section.settings.hero_eyebrow != blank -%}
          <p class="modern-home__eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.hero_heading != blank -%}
          <h1 id="ModernHomeHero-{{ section.id }}" class="modern-home__hero-title">{{ section.settings.hero_heading }}</h1>
        {%- endif -%}

        {%- if section.settings.hero_text != blank -%}
          <div class="modern-home__hero-body">{{ section.settings.hero_text }}</div>
        {%- endif -%}

        {%- if section.settings.hero_primary_label != blank or section.settings.hero_secondary_label != blank -%}
          <div class="modern-home__actions">
            {%- if section.settings.hero_primary_label != blank -%}
              <a class="modern-home__button" href="{{ hero_link | default: routes.all_products_collection_url }}">
                {{ section.settings.hero_primary_label | escape }}
                <span class="modern-home__arrow" aria-hidden="true">{% render 'icon-arrow' %}</span>
              </a>
            {%- endif -%}
            {%- if section.settings.hero_secondary_label != blank -%}
              <a class="modern-home__button modern-home__button--secondary" href="{{ secondary_link | default: routes.collections_url }}">
                {{ section.settings.hero_secondary_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="modern-home__hero-media">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '550, 750, 1000, 1350, 1800', sizes: '(min-width: 990px) 52vw, 100vw', alt: hero_alt }}
        {%- else -%}
          <div class="modern-home__collection-placeholder" role="img" aria-label="{{ section.settings.hero_heading | strip_html | escape }}"></div>
        {%- endif -%}
        {%- if section.settings.hero_note != blank -%}
          <p class="modern-home__hero-note">{{ section.settings.hero_note | escape }}</p>
        {%- endif -%}
      </div>
    </section>

    {%- if section.blocks.size > 0 -%}
      <section class="modern-home__section" aria-labelledby="ModernHomeCollections-{{ section.id }}">
        <div class="modern-home__section-head">
          <div>
            {%- if section.settings.collections_eyebrow != blank -%}
              <p class="modern-home__eyebrow">{{ section.settings.collections_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.collections_heading != blank -%}
              <h2 id="ModernHomeCollections-{{ section.id }}" class="modern-home__section-title">{{ section.settings.collections_heading }}</h2>
            {%- endif -%}
            {%- if section.settings.collections_text != blank -%}
              <div class="modern-home__section-intro">{{ section.settings.collections_text }}</div>
            {%- endif -%}
          </div>
          {%- if section.settings.collections_link_label != blank -%}
            <a class="modern-home__text-link" href="{{ section.settings.collections_link | default: routes.collections_url }}">
              {{ section.settings.collections_link_label | escape }}
              <span class="modern-home__arrow" aria-hidden="true">{% render 'icon-arrow' %}</span>
            </a>
          {%- endif -%}
        </div>

        <div class="modern-home__collection-grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'collection' -%}
              {%- assign card_collection = block.settings.collection -%}
              {%- assign card_image = block.settings.image -%}
              {%- if card_image == blank and card_collection != blank -%}
                {%- assign card_image = card_collection.featured_image -%}
              {%- endif -%}
              {%- assign card_title = block.settings.title | default: card_collection.title -%}
              {%- assign card_alt = card_image.alt | default: card_title | strip_html -%}
              <article class="modern-home__collection-card" {{ block.shopify_attributes }}>
                <a href="{{ card_collection.url | default: routes.collections_url }}" aria-label="{{ card_title | default: 'Explore collection' | escape }}">
                  {%- if card_image != blank -%}
                    {{ card_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360, 550, 750, 1100', sizes: '(min-width: 990px) 25vw, 50vw', alt: card_alt }}
                  {%- else -%}
                    <div class="modern-home__collection-placeholder" role="img" aria-label="{{ card_title | default: 'Collection' | escape }}"></div>
                  {%- endif -%}
                  <div class="modern-home__collection-content">
                    {%- if block.settings.kicker != blank -%}
                      <p class="modern-home__collection-kicker">{{ block.settings.kicker | escape }}</p>
                    {%- endif -%}
                    <h3 class="modern-home__collection-title">{{ card_title | default: 'Explore the collection' | escape }}</h3>
                    <span class="modern-home__collection-link">{{ block.settings.link_label | default: 'View collection' | escape }} <span class="modern-home__arrow" aria-hidden="true">{% render 'icon-arrow' %}</span></span>
                  </div>
                </a>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </div>

  {%- if trust_blocks.size > 0 -%}
    <section class="modern-home__trust" aria-label="{{ section.settings.trust_aria_label | default: 'Why shop with us' | escape }}">
      <div class="modern-home__inner">
        <div class="modern-home__trust-grid">
          {%- for block in trust_blocks -%}
            <div class="modern-home__trust-item" {{ block.shopify_attributes }}>
              <span class="modern-home__trust-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 4C12.3 4.2 6.3 6.6 4.4 11.1c-1.2 2.9.8 5.8 3.8 5.5C13.9 16.1 18.5 11.4 20 4Z"/><path d="M4 21c2.6-4.7 6.2-7.8 11-10"/></svg>
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m12 3 7 3v5c0 4.4-2.8 8.2-7 10-4.2-1.8-7-5.6-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3.5 14.6 9l5.9.7-4.3 4.1 1.1 5.8-5.3-2.8-5.3 2.8 1.1-5.8-4.3-4.1L9.4 9 12 3.5Z"/></svg>
                {%- endcase -%}
              </span>
              <div>
                <h2 class="modern-home__trust-title">{{ block.settings.title | escape }}</h2>
                {%- if block.settings.copy != blank -%}<p class="modern-home__trust-copy">{{ block.settings.copy | escape }}</p>{%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <div class="modern-home__inner">
    {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
      <section class="modern-home__section" aria-labelledby="ModernHomeProducts-{{ section.id }}">
        <div class="modern-home__section-head">
          <div>
            {%- if section.settings.products_eyebrow != blank -%}<p class="modern-home__eyebrow">{{ section.settings.products_eyebrow | escape }}</p>{%- endif -%}
            <h2 id="ModernHomeProducts-{{ section.id }}" class="modern-home__section-title">{{ section.settings.products_heading | default: featured_collection.title }}</h2>
            {%- if section.settings.products_text != blank -%}<div class="modern-home__section-intro">{{ section.settings.products_text }}</div>{%- endif -%}
          </div>
          {%- if section.settings.products_link_label != blank -%}
            <a class="modern-home__text-link" href="{{ featured_collection.url }}">{{ section.settings.products_link_label | escape }} <span class="modern-home__arrow" aria-hidden="true">{% render 'icon-arrow' %}</span></a>
          {%- endif -%}
        </div>

        <div class="modern-home__product-grid">
          {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
            {%- assign product_alt = product.featured_image.alt | default: product.title | strip_html -%}
            <article class="modern-home__product-card">
              <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                <div class="modern-home__product-media">
                  {%- if product.featured_image != blank -%}
                    {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 550, 750, 900', sizes: '(min-width: 990px) 25vw, 50vw', alt: product_alt }}
                  {%- else -%}
                    <div class="modern-home__product-placeholder" role="img" aria-label="{{ product.title | escape }}"></div>
                  {%- endif -%}
                  {%- if product.compare_at_price > product.price -%}<span class="modern-home__product-badge">{{ section.settings.sale_label | default: 'Special' | escape }}</span>{%- endif -%}
                </div>
                <div class="modern-home__product-info">
                  <h3 class="modern-home__product-title">{{ product.title | escape }}</h3>
                  <span class="modern-home__product-price">{{ product.price | money }}</span>
                </div>
              </a>
            </article>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- if section.settings.editorial_heading != blank or section.settings.editorial_image != blank -%}
      {%- assign editorial_alt = section.settings.editorial_image.alt | default: section.settings.editorial_heading | strip_html -%}
      <section class="modern-home__section" aria-labelledby="ModernHomeEditorial-{{ section.id }}">
        <div class="modern-home__editorial">
          <div class="modern-home__editorial-media">
            {%- if section.settings.editorial_image != blank -%}
              {{ section.settings.editorial_image | image_url: width: 1500 | image_tag: loading: 'lazy', widths: '550, 750, 1000, 1500', sizes: '(min-width: 750px) 50vw, 100vw', alt: editorial_alt }}
            {%- else -%}
              <div class="modern-home__editorial-placeholder" role="img" aria-label="{{ section.settings.editorial_heading | strip_html | escape }}"></div>
            {%- endif -%}
          </div>
          <div class="modern-home__editorial-copy">
            {%- if section.settings.editorial_eyebrow != blank -%}<p class="modern-home__eyebrow">{{ section.settings.editorial_eyebrow | escape }}</p>{%- endif -%}
            <h2 id="ModernHomeEditorial-{{ section.id }}" class="modern-home__editorial-title">{{ section.settings.editorial_heading }}</h2>
            {%- if section.settings.editorial_text != blank -%}<div class="modern-home__editorial-text">{{ section.settings.editorial_text }}</div>{%- endif -%}
            {%- if section.settings.editorial_label != blank -%}
              <div class="modern-home__actions"><a class="modern-home__button" href="{{ editorial_link | default: routes.all_products_collection_url }}">{{ section.settings.editorial_label | escape }} <span class="modern-home__arrow" aria-hidden="true">{% render 'icon-arrow' %}</span></a></div>
            {%- endif -%}
          </div>
        </div>
      </section>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Modern home",
  "tag": "section",
  "class": "section-modern-home",
  "settings": [
    { "type": "header", "content": "Brand palette" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f7f7f3" },
    { "type": "color", "id": "surface_color", "label": "Surface", "default": "#eeeee8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#17231f" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#68756f" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#bd7c48" },
    { "type": "color", "id": "accent_contrast_color", "label": "Accent text", "default": "#ffffff" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "The winter edit · 2026" },
    { "type": "inline_richtext", "id": "hero_heading", "label": "Heading", "default": "Fabric with a quieter kind of confidence." },
    { "type": "richtext", "id": "hero_text", "label": "Description", "default": "<p>Thoughtfully sourced fabrics, considered colour and an exceptional hand-feel — made for the way you move.</p>" },
    { "type": "text", "id": "hero_note", "label": "Image note", "default": "Natural fibres · considered details" },
    { "type": "text", "id": "hero_primary_label", "label": "Primary button", "default": "Shop the edit" },
    { "type": "url", "id": "hero_primary_link", "label": "Primary link" },
    { "type": "text", "id": "hero_secondary_label", "label": "Secondary button", "default": "Explore collections" },
    { "type": "url", "id": "hero_secondary_link", "label": "Secondary link" },
    { "type": "select", "id": "hero_content_alignment", "label": "Hero text alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ], "default": "left" },
    { "type": "range", "id": "hero_padding_top", "label": "Hero top spacing", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "hero_padding_bottom", "label": "Hero bottom spacing", "min": 24, "max": 140, "step": 4, "unit": "px", "default": 72 },
    { "type": "header", "content": "Collections" },
    { "type": "text", "id": "collections_eyebrow", "label": "Eyebrow", "default": "Find your finish" },
    { "type": "inline_richtext", "id": "collections_heading", "label": "Heading", "default": "A considered wardrobe starts with the cloth." },
    { "type": "richtext", "id": "collections_text", "label": "Description", "default": "<p>Explore signature weaves and dependable everyday textures, each chosen for comfort, character and lasting wear.</p>" },
    { "type": "text", "id": "collections_link_label", "label": "Link label", "default": "View all collections" },
    { "type": "url", "id": "collections_link", "label": "Link" },
    { "type": "header", "content": "Trust strip" },
    { "type": "text", "id": "trust_aria_label", "label": "Accessibility label", "default": "Why shop with Intikhab Fabrics" },
    { "type": "header", "content": "Featured products" },
    { "type": "collection", "id": "featured_collection", "label": "Product collection" },
    { "type": "text", "id": "products_eyebrow", "label": "Eyebrow", "default": "The signature edit" },
    { "type": "inline_richtext", "id": "products_heading", "label": "Heading", "default": "Pieces with presence." },
    { "type": "richtext", "id": "products_text", "label": "Description", "default": "<p>Our most-loved fabrics, ready to become your next considered staple.</p>" },
    { "type": "text", "id": "products_link_label", "label": "Link label", "default": "Shop the collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "sale_label", "label": "Sale badge", "default": "Special" },
    { "type": "header", "content": "Editorial panel" },
    { "type": "image_picker", "id": "editorial_image", "label": "Image" },
    { "type": "text", "id": "editorial_eyebrow", "label": "Eyebrow", "default": "Made to be lived in" },
    { "type": "inline_richtext", "id": "editorial_heading", "label": "Heading", "default": "The details are in the drape." },
    { "type": "richtext", "id": "editorial_text", "label": "Description", "default": "<p>From first touch to final stitch, every metre is selected to bring ease, texture and quiet confidence to the finished piece.</p>" },
    { "type": "text", "id": "editorial_label", "label": "Button label", "default": "Discover the story" },
    { "type": "url", "id": "editorial_link", "label": "Button link" },
    { "type": "range", "id": "section_padding", "label": "Section spacing", "min": 32, "max": 120, "step": 4, "unit": "px", "default": 84 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Card image" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Explore" },
        { "type": "text", "id": "title", "label": "Custom title" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "View collection" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "leaf", "label": "Leaf" }, { "value": "shield", "label": "Shield" }, { "value": "truck", "label": "Delivery" }, { "value": "star", "label": "Star" } ], "default": "leaf" },
        { "type": "text", "id": "title", "label": "Title", "default": "Thoughtfully sourced" },
        { "type": "text", "id": "copy", "label": "Supporting text", "default": "Quality you can feel" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Modern home",
      "blocks": [
        { "type": "collection", "settings": { "kicker": "Signature weave", "link_label": "View collection" } },
        { "type": "collection", "settings": { "kicker": "Seasonal edit", "link_label": "View collection" } },
        { "type": "collection", "settings": { "kicker": "Everyday luxury", "link_label": "View collection" } },
        { "type": "collection", "settings": { "kicker": "Made to measure", "link_label": "View collection" } },
        { "type": "trust", "settings": { "icon": "leaf", "title": "Thoughtfully sourced", "copy": "Quality you can feel" } },
        { "type": "trust", "settings": { "icon": "shield", "title": "A considered choice", "copy": "Clear, dependable service" } },
        { "type": "trust", "settings": { "icon": "truck", "title": "Delivered with care", "copy": "Packed and sent securely" } },
        { "type": "trust", "settings": { "icon": "star", "title": "Made for keeps", "copy": "Fabrics worth returning to" } }
      ]
    }
  ]
}
{% endschema %}

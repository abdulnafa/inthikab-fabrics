{% comment %}
  Modern product detail section

  This section intentionally keeps Shopify's native product-info/product-form
  contracts (variant events, AJAX add-to-cart, dynamic checkout and media
  gallery updates) while providing a clean, independently scoped presentation.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
-%}

<section
  id="ModernProduct-{{ section.id }}"
  class="modern-product-section section-{{ section.id }}-padding"
  data-section-id="{{ section.id }}"
>
  <product-info
    id="MainProduct-{{ section.id }}"
    class="modern-product"
    data-section="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-update-url="true"
    data-url="{{ product.url }}"
  >
    {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-price.css' | asset_url | stylesheet_tag }}
    {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}

    <div class="modern-product__layout">
      <div class="modern-product__media-column">
        {%- if product.media.size > 0 -%}
          <div class="modern-product__media-shell">
            {% render 'product-media-gallery', variant_images: variant_images, shareb: false %}
          </div>
          {% render 'product-media-modal', variant_images: variant_images %}
          <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
          <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
          {%- if section.settings.image_zoom == 'hover' -%}
            <script src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
          {%- endif -%}
        {%- else -%}
          <div class="modern-product__media-placeholder" aria-hidden="true">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      <div id="ProductInfo-{{ section.id }}" class="modern-product__details">
        <div class="modern-product__eyebrow">
          {%- if product.vendor != blank -%}
            {{ product.vendor | escape }}
          {%- else -%}
            {{ shop.name | escape }}
          {%- endif -%}
        </div>

        <h1 class="modern-product__title">{{ product.title | escape }}</h1>

        <div id="price-{{ section.id }}" class="modern-product__price" role="status">
          <span class="modern-product__price-current">
            {%- if settings.currency_code_enabled -%}
              {{ current_variant.price | money_with_currency }}
            {%- else -%}
              {{ current_variant.price | money }}
            {%- endif -%}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s class="modern-product__price-compare">
              {%- if settings.currency_code_enabled -%}
                {{ current_variant.compare_at_price | money_with_currency }}
              {%- else -%}
                {{ current_variant.compare_at_price | money }}
              {%- endif -%}
            </s>
            <span class="modern-product__price-badge">
              {{- 'products.product.on_sale' | t -}}
            </span>
          {%- endif -%}
        </div>

        {%- if product.description != blank -%}
          <div class="modern-product__intro rte">
            {{ product.description | strip_html | truncatewords: 36 }}
          </div>
        {%- endif -%}

        <div class="modern-product__purchase-card">
          {%- unless product.has_only_default_variant -%}
            <variant-selects
              id="variant-selects-{{ section.id }}"
              class="modern-product__variants"
              data-section="{{ section.id }}"
              data-url="{{ product.url }}"
              data-layout="{{ section.settings.variant_style }}"
            >
              {%- for option in product.options_with_values -%}
                <fieldset class="modern-product__option product-form__input">
                  <legend class="modern-product__option-label">
                    <span>{{ option.name | escape }}</span>
                    {%- if section.settings.variant_style != 'dropdown' -%}
                      <span class="modern-product__option-selected" data-selected-value>
                        {{ option.selected_value | escape }}
                      </span>
                    {%- endif -%}
                  </legend>
                  {%- if section.settings.variant_style == 'dropdown' -%}
                    <div class="modern-product__option-select">
                      <select name="{{ option.name | escape }}" form="{{ product_form_id }}" aria-label="{{ option.name | escape }}">
                        {%- for value in option.values -%}
                          <option
                            value="{{ value | escape }}"
                            data-product-url="{{ value.product_url | default: product.url | escape }}"
                            data-option-value-id="{{ value.id }}"
                            {% if option.selected_value == value %}selected{% endif %}
                            {% unless value.available or option.selected_value == value %}disabled{% endunless %}
                          >{{ value | escape }}{% unless value.available %} — {{ 'products.product.value_unavailable' | t }}{% endunless %}</option>
                        {%- endfor -%}
                      </select>
                      <span aria-hidden="true">⌄</span>
                    </div>
                  {%- else -%}
                    <div class="modern-product__option-values">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign option_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
                          assign value_available = value.available
                          assign value_product_url = value.product_url | default: product.url
                        -%}
                        <input
                          type="radio"
                          id="{{ option_id }}"
                          name="{{ option.name | escape }}"
                          value="{{ value | escape }}"
                          form="{{ product_form_id }}"
                          data-product-url="{{ value_product_url | escape }}"
                          data-option-value-id="{{ value.id }}"
                          {% if option.selected_value == value %}checked{% endif %}
                          {% unless value_available or option.selected_value == value %}disabled{% endunless %}
                        >
                        <label for="{{ option_id }}"{% unless value_available %} class="is-unavailable"{% endunless %}>
                          {{ value | escape }}
                          {% unless value_available %}<span class="visually-hidden">{{ 'products.product.value_unavailable' | t }}</span>{% endunless %}
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </fieldset>
              {%- endfor -%}
              <script type="application/json" data-selected-variant>{{ current_variant | json }}</script>
            </variant-selects>
          {%- endunless -%}

          <div
            id="Quantity-Form-{{ section.id }}"
            class="modern-product__quantity product-form__quantity"
          >
            {%- assign cart_qty = cart | item_count_for_variant: current_variant.id -%}
            <label class="modern-product__field-label" for="Quantity-{{ section.id }}">
              {{ 'products.product.quantity.label' | t }}
            </label>
            <quantity-input class="modern-product__quantity-control" data-url="{{ product.url }}" data-section="{{ section.id }}">
              <button type="button" name="minus" class="quantity__button" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">−</button>
              <input
                class="quantity__input"
                type="number"
                name="quantity"
                id="Quantity-{{ section.id }}"
                value="{{ current_variant.quantity_rule.min }}"
                min="{{ current_variant.quantity_rule.min }}"
                {% if current_variant.quantity_rule.max != null %}max="{{ current_variant.quantity_rule.max }}"{% endif %}
                step="{{ current_variant.quantity_rule.increment }}"
                data-min="{{ current_variant.quantity_rule.min }}"
                data-cart-quantity="{{ cart_qty }}"
                form="{{ product_form_id }}"
                aria-label="{{ 'products.product.quantity.input_label' | t: product: product.title | escape }}"
              >
              <button type="button" name="plus" class="quantity__button" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">+</button>
            </quantity-input>
          </div>

          <product-form class="modern-product__form" data-hide-errors="false">
            <div class="product-form__error-message-wrapper" role="alert" hidden>
              <span class="product-form__error-message"></span>
            </div>
            {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
              <input
                type="hidden"
                name="id"
                value="{{ current_variant.id }}"
                class="product-variant-id"
                disabled
              >
              <div class="modern-product__form-actions">
                <button
                  id="ProductSubmitButton-{{ section.id }}"
                  type="submit"
                  name="add"
                  class="modern-product__add button button--primary"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span>
                    {% if current_variant.available %}
                      {{ 'products.product.add_to_cart' | t }}
                    {% else %}
                      {{ 'products.product.sold_out' | t }}
                    {% endif %}
                  </span>
                  <span class="loading-overlay__spinner hidden" aria-hidden="true">
                    <svg class="spinner" viewBox="0 0 66 66" role="presentation"><circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle></svg>
                  </span>
                </button>
                {%- if section.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              </div>
            {%- endform -%}
          </product-form>
        </div>

        <ul class="modern-product__trust" role="list">
          <li>
            <span class="modern-product__trust-icon" aria-hidden="true">✓</span>
            <span>{{ section.settings.trust_one | escape }}</span>
          </li>
          <li>
            <span class="modern-product__trust-icon" aria-hidden="true">↺</span>
            <span>{{ section.settings.trust_two | escape }}</span>
          </li>
          <li>
            <span class="modern-product__trust-icon" aria-hidden="true">▱</span>
            <span>{{ section.settings.trust_three | escape }}</span>
          </li>
        </ul>

        <div class="modern-product__accordions">
          <details open>
            <summary>{{ section.settings.description_heading | escape }}<span aria-hidden="true">+</span></summary>
            <div class="modern-product__accordion-content rte">{{ product.description }}</div>
          </details>
          <details>
            <summary>{{ section.settings.shipping_heading | escape }}<span aria-hidden="true">+</span></summary>
            <div class="modern-product__accordion-content rte">
              {{ section.settings.shipping_copy }}
            </div>
          </details>
          <details>
            <summary>{{ section.settings.care_heading | escape }}<span aria-hidden="true">+</span></summary>
            <div class="modern-product__accordion-content rte">
              {{ section.settings.care_copy }}
            </div>
          </details>
        </div>
      </div>
    </div>
  </product-info>
</section>

{%- style -%}
  .modern-product-section {
    --modern-ink: #17213a;
    --modern-muted: #6f788c;
    --modern-line: rgba(23, 33, 58, .14);
    --modern-soft: #f7f7f5;
    background: rgb(var(--color-background, 255, 255, 255));
    color: var(--modern-ink);
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .modern-product {
    display: block;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .modern-product__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr);
    gap: clamp(40px, 7vw, 112px);
    align-items: start;
  }
  .modern-product__media-column { min-width: 0; }
  .modern-product__media-shell { position: relative; }
  .modern-product__media-shell media-gallery { display: block; }
  .modern-product__media-shell media-gallery.product__column-sticky { position: static; top: auto; }
  .modern-product__media-shell .productpart_1 { background: var(--modern-soft); border-radius: 18px; overflow: hidden; }
  .modern-product__media-shell .product__media-list { margin: 0; }
  .modern-product__media-shell .product-media-container { border-radius: 18px; }
  .modern-product__media-shell .productpart_2 { margin-top: 14px; }
  .modern-product__media-shell .thumbnail-list { gap: 10px; }
  .modern-product__media-shell .thumbnail { border-radius: 10px; border: 1px solid var(--modern-line); overflow: hidden; }
  .modern-product__media-placeholder { aspect-ratio: 1 / 1.1; background: var(--modern-soft); border-radius: 18px; display: grid; place-items: center; }
  .modern-product__details {
    min-width: 0;
    {% if section.settings.enable_sticky_info %}position: sticky; top: 32px;{% endif %}
  }
  .modern-product__eyebrow { color: var(--modern-muted); font-size: 11px; letter-spacing: .16em; text-transform: uppercase; margin-bottom: 16px; }
  .modern-product__title { color: var(--modern-ink); font-family: var(--font-heading-family, inherit); font-size: clamp(30px, 3.4vw, 54px); font-weight: 500; line-height: 1.05; letter-spacing: -.035em; margin: 0 0 18px; }
  .modern-product__price { align-items: center; display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 22px; }
  .modern-product__price-current { font-size: 20px; font-weight: 600; }
  .modern-product__price-compare { color: var(--modern-muted); font-size: 15px; }
  .modern-product__price-badge { background: #e9f1eb; border-radius: 999px; color: #245e3b; font-size: 11px; letter-spacing: .08em; padding: 5px 9px; text-transform: uppercase; }
  .modern-product__intro { color: var(--modern-muted); font-size: 15px; line-height: 1.7; margin-bottom: 30px; max-width: 52ch; }
  .modern-product__purchase-card { border-bottom: 1px solid var(--modern-line); border-top: 1px solid var(--modern-line); padding: 24px 0 26px; }
  .modern-product__option { border: 0; margin: 0 0 24px; padding: 0; }
  .modern-product__option-label { display: flex; font-size: 13px; font-weight: 600; justify-content: space-between; letter-spacing: .04em; margin-bottom: 12px; }
  .modern-product__option-selected { color: var(--modern-muted); font-weight: 400; }
  .modern-product__option-values { display: flex; flex-wrap: wrap; gap: 8px; }
  .modern-product__option-values input { clip: rect(0 0 0 0); clip-path: inset(50%); height: 1px; overflow: hidden; position: absolute; white-space: nowrap; width: 1px; }
  .modern-product__option-values label { border: 1px solid var(--modern-line); border-radius: 999px; cursor: pointer; font-size: 13px; padding: 10px 15px; transition: border-color .2s, background .2s, color .2s; }
  .modern-product__option-values label:hover { border-color: var(--modern-ink); }
  .modern-product__option-values input:checked + label { background: var(--modern-ink); border-color: var(--modern-ink); color: #fff; }
  .modern-product__option-values input:focus-visible + label { outline: 2px solid currentColor; outline-offset: 3px; }
  .modern-product__option-values input:disabled + label { color: #a4a9b3; cursor: not-allowed; text-decoration: line-through; }
  .modern-product__option-select { position: relative; }
  .modern-product__option-select select { appearance: none; background: transparent; border: 1px solid var(--modern-line); border-radius: 999px; color: var(--modern-ink); font: inherit; font-size: 13px; min-height: 46px; padding: 0 44px 0 16px; width: 100%; }
  .modern-product__option-select select:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .modern-product__option-select > span { color: var(--modern-muted); pointer-events: none; position: absolute; right: 17px; top: 12px; }
  .modern-product__quantity { align-items: center; display: flex; justify-content: space-between; margin: 4px 0 22px; }
  .modern-product__field-label { font-size: 13px; font-weight: 600; letter-spacing: .04em; }
  .modern-product__quantity-control { align-items: center; border: 1px solid var(--modern-line); border-radius: 999px; display: inline-flex; min-height: 44px; }
  .modern-product__quantity-control .quantity__button { align-items: center; background: transparent; border: 0; color: var(--modern-ink); cursor: pointer; display: grid; font-size: 20px; height: 42px; place-items: center; width: 40px; }
  .modern-product__quantity-control .quantity__input { -moz-appearance: textfield; background: transparent; border: 0; color: var(--modern-ink); font-size: 14px; text-align: center; width: 42px; }
  .modern-product__quantity-control .quantity__input::-webkit-inner-spin-button, .modern-product__quantity-control .quantity__input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
  .modern-product__form-actions { display: grid; gap: 10px; }
  .modern-product__add { align-items: center; border-radius: 999px; display: inline-flex; justify-content: center; min-height: 54px; position: relative; width: 100%; }
  .modern-product__add .spinner { height: 20px; width: 20px; }
  .modern-product__form .shopify-payment-button__button { border-radius: 999px; min-height: 54px; }
  .modern-product__trust { border-bottom: 1px solid var(--modern-line); display: grid; gap: 12px; list-style: none; margin: 0; padding: 22px 0; }
  .modern-product__trust li { align-items: center; color: var(--modern-muted); display: flex; font-size: 13px; gap: 10px; }
  .modern-product__trust-icon { align-items: center; border: 1px solid var(--modern-line); border-radius: 50%; color: var(--modern-ink); display: inline-flex; flex: 0 0 25px; font-size: 13px; height: 25px; justify-content: center; width: 25px; }
  .modern-product__accordions details { border-bottom: 1px solid var(--modern-line); }
  .modern-product__accordions summary { align-items: center; cursor: pointer; display: flex; font-size: 14px; font-weight: 600; justify-content: space-between; list-style: none; padding: 18px 0; }
  .modern-product__accordions summary::-webkit-details-marker { display: none; }
  .modern-product__accordions summary span { color: var(--modern-muted); font-size: 20px; font-weight: 300; transition: transform .2s; }
  .modern-product__accordions details[open] summary span { transform: rotate(45deg); }
  .modern-product__accordion-content { color: var(--modern-muted); font-size: 14px; line-height: 1.7; padding: 0 0 18px; }
  @media screen and (max-width: 989px) {
    .modern-product__layout { gap: 42px; grid-template-columns: minmax(0, 1fr) minmax(300px, .8fr); }
    {% if section.settings.enable_sticky_info %}.modern-product__details { top: 20px; }{% endif %}
  }
  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px; }
    .modern-product { padding: 0 16px; }
    .modern-product__layout { display: block; }
    .modern-product__details { margin-top: 28px; position: static; }
    .modern-product__title { font-size: 34px; }
    .modern-product__media-shell .productpart_1 { border-radius: 12px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Modern product",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 900, "max": 1800, "step": 20, "default": 1320, "unit": "px" },
    { "type": "select", "id": "media_size", "label": "Media size", "options": [{ "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" }], "default": "large" },
    { "type": "select", "id": "gallery_layout", "label": "Gallery layout", "options": [{ "value": "columns", "label": "Columns" }, { "value": "thumbnail_slider", "label": "Thumbnail slider" }], "default": "columns" },
    { "type": "select", "id": "mobile_thumbnails", "label": "Mobile thumbnails", "options": [{ "value": "hide", "label": "Hide" }, { "value": "show", "label": "Show" }, { "value": "columns", "label": "Columns" }], "default": "hide" },
    { "type": "select", "id": "media_fit", "label": "Media fit", "options": [{ "value": "cover", "label": "Cover" }, { "value": "contain", "label": "Contain" }], "default": "cover" },
    { "type": "select", "id": "image_zoom", "label": "Image zoom", "options": [{ "value": "none", "label": "None" }, { "value": "hover", "label": "Hover" }, { "value": "lightbox", "label": "Lightbox" }], "default": "lightbox" },
    { "type": "checkbox", "id": "constrain_to_viewport", "label": "Constrain media height", "default": false },
    { "type": "checkbox", "id": "hide_variants", "label": "Hide variant media", "default": false },
    { "type": "checkbox", "id": "enable_video_looping", "label": "Loop product videos", "default": true },
    { "type": "checkbox", "id": "enable_full_width", "label": "Use full-width media", "default": false },
    { "type": "checkbox", "id": "enable_border", "label": "Show media border", "default": false },
    { "type": "checkbox", "id": "enable_sticky_info", "label": "Keep product details visible", "default": false },
    { "type": "select", "id": "variant_style", "label": "Variant layout", "options": [{ "value": "button", "label": "Pills" }, { "value": "dropdown", "label": "Dropdown" }], "default": "button" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout button", "default": true },
    { "type": "text", "id": "trust_one", "label": "Trust message one", "default": "Quality checked before dispatch" },
    { "type": "text", "id": "trust_two", "label": "Trust message two", "default": "Easy returns within 14 days" },
    { "type": "text", "id": "trust_three", "label": "Trust message three", "default": "Secure payment at checkout" },
    { "type": "text", "id": "description_heading", "label": "Description heading", "default": "Details" },
    { "type": "text", "id": "shipping_heading", "label": "Shipping heading", "default": "Shipping & returns" },
    { "type": "richtext", "id": "shipping_copy", "label": "Shipping copy", "default": "<p>Orders are carefully packed and dispatched within 1–2 working days. Returns are accepted on eligible items within 14 days.</p>" },
    { "type": "text", "id": "care_heading", "label": "Care heading", "default": "Care guide" },
    { "type": "richtext", "id": "care_copy", "label": "Care copy", "default": "<p>Follow the care instructions on the product label to preserve the fabric's finish and feel.</p>" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "default": 72, "unit": "px" }
  ],
  "presets": [{ "name": "Modern product" }]
}
{% endschema %}

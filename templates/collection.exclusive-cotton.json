      "name": "Why Intikhab Section",
      "settings": {
        "custom_liquid": "<section class=\"why-intikhab\">\n  <div class=\"why-intikhab-inner\">\n\n    <div class=\"why-intikhab-heading\">\n      <p class=\"why-intikhab-eyebrow\">THE INTIKHAB DIFFERENCE</p>\n\n      <h2>Why Choose Intikhab Fabrics?</h2>\n\n      <div class=\"why-intikhab-line\"></div>\n\n      <p class=\"why-intikhab-intro\">\n        Better Quality. Real Value.\n      </p>\n\n      <p class=\"why-intikhab-description\">\n        We believe good fabric starts long before it reaches your wardrobe.\n        From carefully selected yarns to weaving, finishing and final inspection,\n        every step is handled with attention to quality.\n      </p>\n    </div>\n\n\n    <div class=\"why-intikhab-grid\">\n\n      <!-- 1. Crafted with Care -->\n      <div class=\"why-intikhab-card\">\n\n        <div class=\"why-intikhab-icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <circle cx=\"12\" cy=\"12\" r=\"7\"/>\n            <path d=\"M12 5v14\"/>\n            <path d=\"M9 8h6\"/>\n            <path d=\"M9 12h6\"/>\n            <path d=\"M9 16h6\"/>\n          </svg>\n        </div>\n\n        <h3>Crafted with Care</h3>\n\n        <p>\n          Quality-focused manufacturing from yarn to finished fabric.\n        </p>\n\n      </div>\n\n\n      <!-- 2. Refined Finishes -->\n      <div class=\"why-intikhab-card\">\n\n        <div class=\"why-intikhab-icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M12 3l1.4 5.6L19 10l-5.6 1.4L12 17l-1.4-5.6L5 10l5.6-1.4L12 3Z\"/>\n            <path d=\"M19 16l.6 2.4L22 19l-2.4.6L19 22l-.6-2.4L16 19l2.4-.6L19 16Z\"/>\n          </svg>\n        </div>\n\n        <h3>Refined Finishes</h3>\n\n        <p>\n          Carefully developed finishes for a crisp feel, elegant appearance and lasting comfort.\n        </p>\n\n      </div>\n\n\n      <!-- 3. Factory-Direct Value -->\n      <div class=\"why-intikhab-card\">\n\n        <div class=\"why-intikhab-icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <path d=\"M3 20V10l6 3V9l6 4V6h6v14H3Z\"/>\n            <path d=\"M7 20v-4h3v4\"/>\n            <path d=\"M14 11h2\"/>\n            <path d=\"M18 11h2\"/>\n            <path d=\"M14 15h2\"/>\n            <path d=\"M18 15h2\"/>\n          </svg>\n        </div>\n\n        <h3>Factory-Direct Value</h3>\n\n        <p>\n          Better quality at honest prices, without unnecessary markups.\n        </p>\n\n      </div>\n\n\n      <!-- 4. Made for You -->\n      <div class=\"why-intikhab-card\">\n\n        <div class=\"why-intikhab-icon\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n            <circle cx=\"6\" cy=\"7\" r=\"2.5\"/>\n            <circle cx=\"6\" cy=\"17\" r=\"2.5\"/>\n            <path d=\"M8 8.5 20 20\"/>\n            <path d=\"M8 15.5 20 4\"/>\n          </svg>\n        </div>\n\n        <h3>Made for You</h3>\n\n        <p>\n          Fabrics selected for weddings, formal occasions and everyday sophistication.\n        </p>\n\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n\n<style>\n\n  /* =========================================\n     WHY INTIKHAB — FULL WIDTH\n  ========================================= */\n\n .shopify-section:has(.why-intikhab) {\n  position: relative !important;\n  display: block !important;\n  clear: both !important;\n  float: none !important;\n  margin-top: 0 !important;\n  margin-bottom: 0 !important;\n  padding-top: 0 !important;\n  padding-bottom: 0 !important;\n  transform: none !important;\n}\n  .why-intikhab {\n    background: #0B1B2B;\n\n    padding: 65px 20px;\n\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n\n    width: 100vw;\n    box-sizing: border-box;\n  }\n\n  .why-intikhab-inner {\n    max-width: 1100px;\n    margin: 0 auto;\n  }\n\n\n  /* =========================================\n     HEADING\n  ========================================= */\n\n  .why-intikhab-heading {\n    text-align: center;\n\n    max-width: 780px;\n\n    margin: 0 auto 42px;\n  }\n\n  .why-intikhab-eyebrow {\n    margin: 0 0 10px;\n\n    color: #C9A24D;\n\n    font-size: 11px;\n    font-weight: 600;\n\n    letter-spacing: 2.5px;\n\n    text-transform: uppercase;\n  }\n\n  .why-intikhab-heading h2 {\n    margin: 0;\n\n    color: #FFFFFF;\n\n    font-size: 34px;\n    line-height: 1.2;\n\n    font-weight: 600;\n  }\n\n  .why-intikhab-line {\n    width: 55px;\n    height: 2px;\n\n    background: #C9A24D;\n\n    margin: 18px auto;\n  }\n\n  .why-intikhab-intro {\n    margin: 0 0 10px;\n\n    color: #C9A24D;\n\n    font-size: 18px;\n    font-weight: 600;\n  }\n\n  .why-intikhab-description {\n    margin: 0;\n\n    color: #E8E8E8;\n\n    font-size: 15px;\n    line-height: 1.7;\n  }\n\n\n  /* =========================================\n     CARDS\n  ========================================= */\n\n  .why-intikhab-grid {\n    display: grid;\n\n    grid-template-columns: repeat(4, 1fr);\n\n    gap: 18px;\n  }\n\n  .why-intikhab-card {\n    background: #FFFFFF;\n\n    padding: 28px 20px;\n\n    text-align: center;\n\n    border: 1px solid rgba(201, 162, 77, 0.35);\n\n    box-sizing: border-box;\n  }\n\n\n  /* =========================================\n     ICONS\n  ========================================= */\n\n  .why-intikhab-icon {\n    width: 42px;\n    height: 42px;\n\n    margin: 0 auto 16px;\n\n    display: flex;\n\n    align-items: center;\n    justify-content: center;\n\n    color: #C9A24D;\n\n    border: 1px solid #C9A24D;\n\n    border-radius: 50%;\n\n    box-sizing: border-box;\n  }\n\n  .why-intikhab-icon svg {\n    width: 22px;\n    height: 22px;\n\n    fill: none;\n\n    stroke: #C9A24D;\n\n    stroke-width: 1.4;\n\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n\n  /* =========================================\n     CARD TEXT\n  ========================================= */\n\n  .why-intikhab-card h3 {\n    margin: 0 0 10px;\n\n    color: #0B1B2B;\n\n    font-size: 16px;\n\n    font-weight: 600;\n\n    line-height: 1.3;\n  }\n\n  .why-intikhab-card p {\n    margin: 0;\n\n    color: #555555;\n\n    font-size: 13px;\n\n    line-height: 1.6;\n  }\n\n\n  /* =========================================\n     MOBILE\n  ========================================= */\n\n  @media screen and (max-width: 749px) {\n\n    .shopify-section:has(.why-intikhab) {\n      margin-top: -40px !important;\n    }\n\n    .why-intikhab {\n      padding: 45px 16px;\n    }\n\n    .why-intikhab-heading {\n      margin-bottom: 30px;\n    }\n\n    .why-intikhab-eyebrow {\n      font-size: 10px;\n      letter-spacing: 2px;\n    }\n\n    .why-intikhab-heading h2 {\n      font-size: 27px;\n    }\n\n    .why-intikhab-intro {\n      font-size: 16px;\n    }\n\n    .why-intikhab-description {\n      font-size: 14px;\n      line-height: 1.65;\n    }\n\n    .why-intikhab-grid {\n      grid-template-columns: repeat(2, 1fr);\n      gap: 10px;\n    }\n\n    .why-intikhab-card {\n      padding: 22px 14px;\n    }\n\n    .why-intikhab-icon {\n      width: 38px;\n      height: 38px;\n\n      margin-bottom: 13px;\n    }\n\n    .why-intikhab-icon svg {\n      width: 20px;\n      height: 20px;\n    }\n\n    .why-intikhab-card h3 {\n      font-size: 14px;\n    }\n\n    .why-intikhab-card p {\n      font-size: 12px;\n      line-height: 1.55;\n    }\n\n  }\n\n</style>",

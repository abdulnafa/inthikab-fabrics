          "type": "collapsible_row",
          "settings": {
            "heading": "Are your products ethically sourced?",
            "icon": "none",
            "row_content": "<p>Yes, we are committed to ethical and sustainable practices throughout our supply chain. We work closely with our suppliers to ensure that our products are sourced responsibly and produced under fair working conditions.</p>",
            "page": ""
          }
        },
        "template--16391993851961__97242259-b81f-4b22-b380-d0f66a6a277b-collapsible_row-3": {
